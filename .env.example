# -----------------------------------------------------------------------------
# GOR Diamonds — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local
# -----------------------------------------------------------------------------

# Database — Prisma
# For local dev you can start with SQLite by changing prisma/schema.prisma
# provider to "sqlite" and DATABASE_URL to "file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/gor_diamonds?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with:  openssl rand -base64 32"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (for order confirmations & CRM outreach) — optional at this stage
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GOR Diamonds <noreply@gordiamonds.com>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
